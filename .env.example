# ============================================
# CONFIGURAÇÕES DO SERVIDOR FTP
# ============================================

# Endereço do servidor FTP (sem http:// ou ftp://)
# Exemplo: ftp.seuservidor.com.br
FTP_HOST=seu-servidor-ftp.com.br

# Porta do servidor FTP (padrão: 21)
FTP_PORT=21

# Usuário para autenticação no FTP
FTP_USER=seu_usuario

# Senha para autenticação no FTP
FTP_PASSWORD=sua_senha

# Caminho da pasta no servidor FTP onde estão as imagens
# Exemplo: /imagens ou /public_html/fotos
FTP_REMOTE_PATH=/

# ============================================
# CONFIGURAÇÕES LOCAIS
# ============================================

# Pasta local onde as imagens serão salvas
# Deixe como ./images ou defina outro caminho
LOCAL_PATH=./images
